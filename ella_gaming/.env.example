# ======================= Ella Gaming server - copy to .env (never commit it) =======================
# REQUIRED -----------------------------------------------------------------------------------------
# The SAME bot token the bot uses. Telegram signs Mini App logins with it, so it is the only way to verify them.
ELLA_BOT_TOKEN=123456:put-the-bots-token-here
# Random secret that signs Ella's own session tokens (>= 32 chars). Generate:  python -c "import secrets;print(secrets.token_urlsafe(48))"
ELLA_SESSION_SECRET=
# The https origin players open the Mini App from (no trailing path). Also used as the attribution host sent to GameZipper.
ELLA_PUBLIC_URL=https://games.example.com

# OPTIONAL -----------------------------------------------------------------------------------------
# Where the SQLite database (ella_gaming.sqlite3) and the catalogue cache live. Put it on a persistent disk / volume.
ELLA_DATA_DIR=./data
PORT=8080
ELLA_HOST=0.0.0.0
# Telegram user ids allowed to read /api/admin/report and trigger a re-scan (comma separated). Leave empty to disable.
ELLA_ADMIN_IDS=
# Behind Caddy / nginx / a platform proxy: true so rate limits see the real client IP. Only enable when a proxy you control sets X-Forwarded-For.
ELLA_TRUST_PROXY=true

# Game provider
# GameZipper is OFF by default (GamePix only). To turn it on: ELLA_CATALOGUE_URL=https://gamezipper.com/api/games.json
# ELLA_GAMEPIX_SID=9HOS3
# ELLA_GAMEPIX_MAX=10000   (all GamePix games, about 6500)
ELLA_EMBED_HOSTS=gamezipper.com
ELLA_CATALOGUE_TTL=21600
# verified_only (default): show only games whose ad check came back clean.  trust_provider: also show unchecked games (NOT ad-free-safe).
ELLA_ADS_POLICY=show_all
ELLA_SCAN_BROWSER=1
ELLA_SCAN_TTL=604800
ELLA_SCAN_CONCURRENCY=6

# Frontend hosted on a different origin than the API (see README "Option B"): serve no pages here and allow that origin.
# ELLA_SERVE_FRONTEND=0
# ELLA_ALLOWED_ORIGINS=https://games-ui.example.pages.dev

# Limits
ELLA_RATE_IP_PER_MIN=240
ELLA_RATE_AUTH_PER_MIN=20
ELLA_RATE_WRITE_PER_MIN=90
ELLA_INITDATA_MAX_AGE=86400
ELLA_TOKEN_TTL=21600
