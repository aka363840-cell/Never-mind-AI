# ---- Telegram ----
BOT_TOKEN=put-your-NEW-botfather-token-here
OWNER_ID=8445198778
# (unused: there are no moderators, only OWNER_ID has admin powers)
ADMIN_IDS=

# ---- Database / Redis ----
DATABASE_URL=postgresql+asyncpg://bot:bot@localhost:5432/bot
# Leave empty to run without Redis (in-memory fallback, single process only)
REDIS_URL=redis://localhost:6379/0

# ---- AI (Google Gemini free tier) ----
AI_PROVIDER=gemini
# Up to 4 keys, comma separated. Use keys from DIFFERENT Google projects (quota is per project).
# When one runs out the bot switches to the next automatically. GEMINI_API_KEY (single) still works.
GEMINI_API_KEYS=
GEMINI_API_KEY=put-your-NEW-gemini-key-here
# Comma-separated, tried in order. Only free-tier Flash / Flash-Lite models; Pro models are refused.
GEMINI_MODELS=gemini-3.6-flash,gemini-3.5-flash,gemini-3.1-flash-lite,gemini-flash-latest,gemini-flash-lite-latest
AI_CONTEXT_MESSAGES=6
AI_CONVERSATION_TTL_MIN=60
AI_USER_RPM=6
AI_USER_DAILY=120
AI_GLOBAL_RPM=10
AI_MAX_INPUT_CHARS=800
AI_MAX_OUTPUT_TOKENS=450
# ---- Backup AI providers (all optional, all have free tiers). Add as many keys as you like; the bot uses the first
# provider that answers and switches INSTANTLY when one is busy / out of quota. Providers without a key are skipped.
# Order of priority (first = tried first). Remove a name to disable it.
AI_PROVIDERS=gemini,groq,cloudflare,cerebras,openrouter,mistral,custom
# If the first provider has not answered after this many seconds, the next one starts in PARALLEL (first answer wins).
AI_HEDGE_S=2.5
# Groq      https://console.groq.com/keys
GROQ_API_KEYS=
# GROQ_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b,qwen/qwen3.6-27b
# Cloudflare Workers AI (needs the API token AND your Account ID: dash.cloudflare.com -> Workers AI)
CLOUDFLARE_API_KEYS=
CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_MODELS=@cf/openai/gpt-oss-120b,@cf/meta/llama-3.3-70b-instruct-fp8-fast,@cf/meta/llama-3.1-8b-instruct
# Cerebras  https://cloud.cerebras.ai
CEREBRAS_API_KEYS=
# CEREBRAS_MODELS=llama3.1-8b,qwen-3-235b-a22b-instruct-2507
# OpenRouter https://openrouter.ai/keys  (free models end with :free)
OPENROUTER_API_KEYS=
# OPENROUTER_MODELS=openrouter/free,meta-llama/llama-3.3-70b-instruct:free
# Mistral   https://console.mistral.ai
MISTRAL_API_KEYS=
# MISTRAL_MODELS=mistral-small-latest
# Any other OpenAI-compatible service (SambaNova, NVIDIA NIM, GitHub Models, ...)
CUSTOM_AI_NAME=custom
CUSTOM_AI_BASE_URL=
CUSTOM_AI_API_KEYS=
CUSTOM_AI_MODELS=

# Speed guard: one AI request waits at most AI_REQUEST_TIMEOUT_S, the whole reply at most AI_REPLY_BUDGET_S (then 'busy' is shown)
AI_REQUEST_TIMEOUT_S=6
AI_REPLY_BUDGET_S=10

# ---- Game rules override (optional JSON file, see README) ----
RULES_FILE=

# Names that make the bot reply in groups (comma-separated, case-insensitive)
BOT_NAMES=

# Where daily SQLite backups are kept (last 7)
BACKUP_DIR=backups

# ---- Premium emoji packs (optional; default = RestrictedEmoji, sexypiyush69_79e604_by_SexyPiyush_BOT, FinanceEmoji) ----
# EMOJI_PACKS=RestrictedEmoji,sexypiyush69_79e604_by_SexyPiyush_BOT,FinanceEmoji

# ---- Branding / extras ----
# The bot's display name is read LIVE from Telegram (BotFather name) - rename it there and everything follows.
# BRAND_EMOJI=🦋
# Reaction GIFs for /hug /kiss /slap ... (nekos.best / waifu.pics). Set to off to disable.
# GIFS=on

# ---- Low-memory / small-host tuning (bot-hosting.net, 128-512 MB) ----
# glibc memory arenas (lower = less RAM); family-tree picture sharpness (3 = full quality, 2 = lighter on RAM)
MALLOC_ARENA_MAX=2
TREE_SUPERSAMPLE=3
# How many profile pictures are kept in memory for /familytree
AVATAR_CACHE=100
# Keep logs short on a panel console
LOG_LEVEL=INFO
